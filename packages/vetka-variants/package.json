{
  "name": "vetka-variants",
  "scopeCommitName": "variants",
  "version": "0.1.0",
  "description": "Class variants with inheritance: base, variants, defaults, compound variants and `extends`.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-omi-io/vetka.git",
    "directory": "packages/vetka-variants"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "omi-io-pkg clean",
